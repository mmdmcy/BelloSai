# Copy to .env.local (Vite) and fill in the values. Never commit real values.

# ---------------------------------------------------------------------------
# Frontend (Vite / Cloudflare Worker). These are public by design, but they
# are read from the environment so no project is hardcoded in the source.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Stripe Price IDs (from your Stripe Dashboard)
VITE_STRIPE_PRICE_ID_MONTHLY=your_monthly_price_id
VITE_STRIPE_PRICE_ID_YEARLY=your_yearly_price_id

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets. Set with `supabase secrets set NAME=...`,
# never shipped to the browser. SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
# ---------------------------------------------------------------------------
# Provider keys (the server calls the providers; the client never holds these)
DEEPSEEK_API_KEY=your_deepseek_api_key
CLAUDE_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_google_ai_api_key
GROQ_API_KEY=your_groq_api_key
MISTRAL_API_KEY=your_mistral_api_key
QWEN_API_KEY=your_qwen_api_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Server-side quota for anonymous (not signed-in) chat requests, per client IP
# per UTC day. Defaults to 3 when unset.
ANON_DAILY_MESSAGE_LIMIT=3
# Optional secret mixed into the IP hash so stored hashes cannot be reversed
# by brute-forcing the IPv4 space.
ANON_QUOTA_SALT=
